rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── FOTO KAMAR (rooms/) ───────────────────────────────────────────────
    match /rooms/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── FOTO GALERI (gallery/) ────────────────────────────────────────────
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── DEFAULT KEAMANAN ──────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
